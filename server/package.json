    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-async-handler": "^1.2.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.18.0",
    "mongosh": "^2.9.2",
    "multer": "^2.2.0",
    "validator": "^13.15.35"
