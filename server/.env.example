PORT=5000
CLIENT_ORIGIN=http://localhost:5173
SCHOOL_TIMEZONE=Asia/Kolkata
# Private PDF storage; blank uses server/.private-resources. Never expose as static files.
RESOURCE_STORAGE_DIR=
RESOURCE_MAX_MB=10
NODE_ENV=development
# Transactions require a replica set, including for local development.
MONGO_URI=mongodb://127.0.0.1:27017/school_erp?replicaSet=rs0
# Generate a long random secret; never reuse the example value.
JWT_SECRET=
# Set only for npm run bootstrap:admin, then remove these values.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
